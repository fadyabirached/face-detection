# ============================================================
#  .gitignore - Files to never commit to Git
# ============================================================

# Environment & secrets
.env

# Trained model artifacts (generated by the notebook, depend on the
# dataset the user trains on locally — see README "Reproducing the model")
*.pkl
*.npy
*.npz
*.pt
*.pth
!face_recognition_model.pkl
!idx2label.npy  
*.whl
# Dataset (downloaded from Kaggle, never committed)
lfw_dataset/
*.zip

# Python cache
__pycache__/
*.py[cod]
*.pyo
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Test / coverage artifacts
.coverage
htmlcov/

# Notebook checkpoints
.ipynb_checkpoints/

# Virtual environment
venv/
env/
.venv/

# VS Code
.vscode/
*.code-workspace

# OS files
.DS_Store
Thumbs.db

# Logs
*.log
logs/

# Output images generated by the notebook / app
outputs/
*.png
*.jpg
!screenshots/*.png
