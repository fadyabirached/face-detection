# Copy this file to .env and adjust as needed.
# Every variable here has a sensible default in config.py — only set
# what you want to override.

# Paths to the trained model artifacts (see README -> "Reproducing the model")
MODEL_PATH=face_recognition_model.pkl
LABELS_PATH=idx2label.npy

# Gradio server
SERVER_NAME=0.0.0.0
SERVER_PORT=7860
SHARE=false

# Unknown-face rejection (see README -> "Handling unrecognized faces")
# Top-1 candidate must be at least this many times more confident than
# the runner-up to be accepted as a real match.
MIN_MARGIN_RATIO=1.5
# Top-1 candidate below this confidence (%) is rejected outright,
# regardless of margin.
MIN_ABS_CONFIDENCE=3.0
